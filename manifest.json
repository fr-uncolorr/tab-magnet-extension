{
  "manifest_version": 3,
  "name": "Tab Magnet",
  "version": "1.1.0",
  "description": "An extension to visually organize tabs from the same host close together.",
  "permissions": ["tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Order tabs"
  },
  "icons": {
    "48": "icons/48.png"
  }
}
