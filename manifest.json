{
  "manifest_version": 3,
  "name": "Tab Magnet",
  "version": "1.2.0",
  "description": "An extension to visually organize tabs from the same host close together.",
  "permissions": ["tabs", "nativeMessaging", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "default_locale": "en"
}
